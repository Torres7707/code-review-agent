# 复制为 .env.local（不要提交！）。只在服务端使用，不要加 NEXT_PUBLIC_ 前缀。

# 方式 A（推荐）：Vercel AI Gateway —— https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
# 模型字符串格式 "provider/model"
AI_MODEL=openai/gpt-5-mini

# 方式 B：直接用某个 provider 的 key（需 npm i @ai-sdk/openai，并在 route.ts 里用 openai("gpt-5-mini")）
# OPENAI_API_KEY=

# GitHub OAuth App —— https://github.com/settings/developers → New OAuth App
# Authorization callback URL 填：http://localhost:3000/api/auth/callback
# 部署到 Vercel 后，把 https://<your-app>.vercel.app/api/auth/callback 也加进同一个 App 的
# callback URL 列表（GitHub 允许一个 App 配多个回调地址），再把这两个值配到 Vercel 环境变量。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 会话 cookie 的 AES-GCM 加密密钥。生产环境必填；本地开发不填时回退用 GITHUB_CLIENT_SECRET。
# 生成方式：openssl rand -base64 32
SESSION_SECRET=
